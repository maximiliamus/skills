{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunbookRegistry",
  "description": "Optional repository-local mapping of runbook IDs to Markdown files.",
  "type": "object",
  "required": [
    "schemaVersion",
    "runbooks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "runbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Lowercase kebab-case ID outside the reserved path-session namespace.",
            "pattern": "^(?!path-[0-9a-f]{12}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\s)(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.[mM][dD](?![\\s\\S])"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
